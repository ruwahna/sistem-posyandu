// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// POSYANDU
// ─────────────────────────────────────────────────────────────
model Posyandu {
  id         String   @id @default(uuid())
  nama       String
  desa       String
  kecamatan  String
  alamat     String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  kaders        Kader[]
  balitas       Balita[]
  lansias       Lansia[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("posyandu")
}

// ─────────────────────────────────────────────────────────────
// KADER / USER
// ─────────────────────────────────────────────────────────────
model Kader {
  id          String   @id @default(uuid())
  posyanduId  String   @map("posyandu_id")
  nama        String
  email       String   @unique
  password    String
  role        Role     @default(KADER)
  isActive    Boolean  @default(true) @map("is_active")
  resetPasswordToken   String?   @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  posyandu Posyandu @relation(fields: [posyanduId], references: [id], onDelete: Cascade)

  @@map("kader")
}

enum Role {
  OWNER
  KADER
}

// ─────────────────────────────────────────────────────────────
// BALITA
// ─────────────────────────────────────────────────────────────
model Balita {
  id            String        @id @default(uuid())
  posyanduId    String        @map("posyandu_id")
  nama          String
  nik           String?
  noHp          String?       @map("no_hp")
  tanggalLahir  DateTime      @map("tanggal_lahir") @db.Date
  jenisKelamin  JenisKelamin  @map("jenis_kelamin")
  namaIbu       String        @map("nama_ibu")
  alamat        String
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  posyandu     Posyandu           @relation(fields: [posyanduId], references: [id], onDelete: Cascade)
  pemeriksaans PemeriksaanBalita[]

  @@map("balita")
}

model PemeriksaanBalita {
  id             String      @id @default(uuid())
  balitaId       String      @map("balita_id")
  tanggalPeriksa DateTime    @map("tanggal_periksa") @db.Date
  usiaBulan      Int         @map("usia_bulan")
  beratBadan     Decimal     @map("berat_badan") @db.Decimal(5, 2)
  tinggiBadan    Decimal     @map("tinggi_badan") @db.Decimal(5, 2)
  lingkarKepala  Decimal?    @map("lingkar_kepala") @db.Decimal(5, 2)
  lingkarLengan  Decimal?    @map("lingkar_lengan") @db.Decimal(5, 2)
  statusBbU      StatusBbU   @map("status_bb_u")
  statusTbU      StatusTbU   @map("status_tb_u")
  statusBbTb     StatusBbTb  @map("status_bb_tb")
  statusKms      String?     @map("status_kms")
  vitaminA       Boolean     @map("vitamin_a")
  asiEksklusif   Boolean?    @map("asi_eksklusif")
  obatCacing     Boolean?    @map("obat_cacing")
  statusImunisasi String?    @map("status_imunisasi")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  // Relations
  balita Balita @relation(fields: [balitaId], references: [id], onDelete: Cascade)

  @@map("pemeriksaan_balita")
}

// ─────────────────────────────────────────────────────────────
// LANSIA
// ─────────────────────────────────────────────────────────────
model Lansia {
  id                      String           @id @default(uuid())
  posyanduId              String           @map("posyandu_id")
  nama                    String
  nik                     String
  noBpjs                  String?          @map("no_bpjs")
  rtRw                    String           @map("rt_rw")
  tanggalLahir            DateTime         @map("tanggal_lahir") @db.Date
  jenisKelamin            JenisKelamin     @map("jenis_kelamin")
  alamat                  String
  riwayatHt               Boolean          @default(false) @map("riwayat_ht")
  riwayatDm               Boolean          @default(false) @map("riwayat_dm")
  tingkatKemandirian      Kemandirian      @map("tingkat_kemandirian")
  gangguanMentalEmosional String?          @map("gangguan_mental_emosional") @db.Text
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  // Relations
  posyandu     Posyandu            @relation(fields: [posyanduId], references: [id], onDelete: Cascade)
  pemeriksaans PemeriksaanLansia[]

  @@map("lansia")
}

model PemeriksaanLansia {
  id                  String   @id @default(uuid())
  lansiaId            String   @map("lansia_id")
  tanggalPeriksa      DateTime @map("tanggal_periksa") @db.Date
  beratBadan          Decimal  @map("berat_badan") @db.Decimal(5, 2)
  tinggiBadan         Decimal  @map("tinggi_badan") @db.Decimal(5, 2)
  tekananDarahSistol  Int      @map("tekanan_darah_sistol")
  tekananDarahDiastol Int      @map("tekanan_darah_diastol")
  gulaDarahSewaktu    Decimal  @map("gula_darah_sewaktu") @db.Decimal(6, 2)
  lingkarPerut        Decimal  @map("lingkar_perut") @db.Decimal(5, 2)
  kolesterol          Decimal? @map("kolesterol") @db.Decimal(6, 2)
  asamUrat            Decimal? @map("asam_urat") @db.Decimal(5, 2)
  keluhan             String?  @map("keluhan") @db.Text
  tindakan            String?  @map("tindakan") @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  lansia Lansia @relation(fields: [lansiaId], references: [id], onDelete: Cascade)

  @@map("pemeriksaan_lansia")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────
enum JenisKelamin {
  L
  P
}

enum StatusBbU {
  SK
  K
  N
  L
}

enum StatusTbU {
  SP
  P
  N
  T
}

enum StatusBbTb {
  SK
  K
  N
  G
}

enum Kemandirian {
  A
  B
  C
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────────────────────────
model Notification {
  id         String   @id @default(uuid())
  posyanduId String   @map("posyandu_id")
  title      String
  message    String   @db.Text
  type       String   @default("INFO") // DANGER | WARNING | SUCCESS | INFO
  category   String   @default("system") // balita | lansia | system
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  posyandu Posyandu @relation(fields: [posyanduId], references: [id], onDelete: Cascade)

  @@map("notification")
}

// ─────────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(uuid())
  posyanduId String?  @map("posyandu_id")
  kaderId    String?  @map("kader_id")
  kaderNama  String?  @map("kader_nama")
  action     String   // E.g. LOGIN, BACKUP_DATA, RESET_POSYANDU
  details    String?  @db.Text
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  posyandu Posyandu? @relation(fields: [posyanduId], references: [id], onDelete: SetNull)

  @@map("audit_log")
}
